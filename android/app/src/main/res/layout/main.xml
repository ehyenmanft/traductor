<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ================= Entrada: solo logo, título, usuario y clave ================= -->
        <LinearLayout
            android:id="@+id/login"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="48dp"
                android:contentDescription="@null"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Traductor en vivo"
                android:textColor="@color/texto"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Entra con el usuario y la clave que te dio el administrador"
                android:textColor="@color/tenue"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/usuario"
                style="@style/Campo"
                android:layout_marginTop="36dp"
                android:autofillHints="username"
                android:hint="Usuario"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:maxLength="32"
                android:singleLine="true" />

            <EditText
                android:id="@+id/clave"
                style="@style/Campo"
                android:layout_marginTop="12dp"
                android:autofillHints="password"
                android:hint="Clave"
                android:imeOptions="actionGo"
                android:inputType="textPassword"
                android:singleLine="true" />

            <Button
                android:id="@+id/entrar"
                style="@style/BotonPrincipal"
                android:layout_marginTop="24dp"
                android:text="Entrar" />

            <TextView
                android:id="@+id/errorLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/rojo"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ================= Panel ================= -->
        <LinearLayout
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/logo" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Traductor en vivo"
                    android:textColor="@color/texto"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/usuariosBtn"
                    style="@style/Enlace"
                    android:paddingEnd="4dp"
                    android:text="Usuarios"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/salir"
                    style="@style/Enlace"
                    android:text="Cerrar sesión" />
            </LinearLayout>

            <TextView
                android:id="@+id/estado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Listo"
                android:textColor="@color/texto"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subestado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Toca el botón para empezar a traducir"
                android:textColor="@color/tenue"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp">

                <View
                    android:id="@+id/brillo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageButton
                    android:id="@+id/boton"
                    android:layout_width="136dp"
                    android:layout_height="136dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circulo"
                    android:contentDescription="Iniciar o detener la traducción"
                    android:padding="38dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_wave" />
            </FrameLayout>

            <TextView
                android:id="@+id/mensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/rojo"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Idioma y fuente del audio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/tarjeta"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/idiomaBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Rotulo" android:text="TRADUCIR AL" />
                    <TextView android:id="@+id/idioma" style="@style/Valor" android:text="Español  ▾" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="#1FFFFFFF" />

                <LinearLayout
                    android:id="@+id/fuenteBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Rotulo" android:text="AUDIO" />
                    <TextView android:id="@+id/fuente" style="@style/Valor" android:text="Del móvil  ▾" />
                </LinearLayout>
            </LinearLayout>

            <!-- Consejos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/tarjeta"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView style="@style/Rotulo" android:text="CÓMO FUNCIONA" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Los subtítulos flotan sobre tus apps y juegos. Al iniciar, Android pide permiso para grabar: elige Pantalla completa (solo se usa el audio).\n\nLas llamadas de voz (Discord, WhatsApp) Android no deja capturarlas: para eso elige Micrófono.\n\nEl botón ⏸ del panel flotante pausa la traducción sin gastar nada."
                    android:textColor="@color/tenue"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/cuenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="4dp"
                android:textColor="@color/texto"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
