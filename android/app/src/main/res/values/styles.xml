<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/fondo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/fondo</item>
        <item name="android:colorAccent">@color/violeta</item>
        <item name="android:textColorPrimary">@color/texto</item>
    </style>

    <style name="Rotulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/tenue</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Valor">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/campo</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">#669A93B8</item>
        <item name="android:textSize">16sp</item>
        <item name="android:importantForAutofill">yes</item>
    </style>

    <style name="Enlace">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:textColor">@color/enlace</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="BotonPrincipal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/boton</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
